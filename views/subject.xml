<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id='student_subject_list_view' model='ir.ui.view'>
        <field name='name'>students.subject.list</field>
        <field name='model'>students.subject</field>
        <field name='arch' type='xml'>
            <list>
                <field name='name'/>
            </list>
        </field>
    </record>

    <record id='student_subject_form_view' model='ir.ui.view'>
        <field name='name'>students.subject.form</field>
        <field name='model'>students.subject</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <group>
                        <field name='name'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id='student_subject_action' model='ir.actions.act_window'>
        <field name='name'>Subjects</field>
        <field name='res_model'>students.subject</field>
        <field name='view_mode'>list,form</field>
    </record>
</odoo>