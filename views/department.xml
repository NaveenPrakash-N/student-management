<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department List View -->
    <record id="student_department_list_view" model="ir.ui.view">
        <field name="name">students.department.list</field>
        <field name="model">students.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Department Form View -->
    <record id="student_department_form_view" model="ir.ui.view">
        <field name="name">students.department.form</field>
        <field name="model">students.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Department Action -->
    <record id="student_department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">students.department</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>