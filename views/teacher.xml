<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_teacher_list_view" model="ir.ui.view">
        <field name="name">students.teacher.list</field>
        <field name="model">students.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="student_teacher_form_view" model="ir.ui.view">
        <field name="name">students.teacher.form</field>
        <field name="model">students.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="user_id"/>
                    </group>
                    <field name="student_ids">
                        <list>
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_teacher_action" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">students.teacher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>